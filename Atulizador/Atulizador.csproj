<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Propositalmente SEM UseWindowsForms: combinar WPF + WinForms no mesmo projeto faz o
         SDK gerar usings globais para os dois, e tipos como Button/TextBox/MessageBox/
         Orientation existem nos dois namespaces — vira erro de referência ambígua em
         quase todo arquivo. Para a escolha de pasta usamos Microsoft.Win32.OpenFolderDialog
         (nativo do WPF a partir do .NET 8), então não precisamos do WinForms. -->
    <AssemblyName>IMS-Toolkit</AssemblyName>
    <RootNamespace>Atulizador</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.0.0.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\icone.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="49.0.2" />
  </ItemGroup>

</Project>
