<UserControl x:Class="Atulizador.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             Background="#0B1229">
    <Grid>
        <Border x:Name="Box" Background="White" CornerRadius="14" Width="360" Height="420"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="40,0,40,0" VerticalAlignment="Center">
                <Border Background="#3457FF" CornerRadius="10" Width="48" Height="48"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="IMS" Foreground="White" FontWeight="Bold" FontSize="15"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="IMS Toolkit" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                           Foreground="#161B2E" HorizontalAlignment="Center"/>
                <TextBlock Text="Entre com seu usuário e senha do FTP" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#6C7488" HorizontalAlignment="Center" Margin="0,2,0,24"/>

                <TextBox x:Name="EntryUsuario" Height="40" BorderBrush="#E2E5EC" BorderThickness="1"
                         Padding="8,0,8,0" VerticalContentAlignment="Center" FontFamily="Segoe UI"
                         Margin="0,0,0,10" KeyDown="EntryUsuario_KeyDown"/>

                <PasswordBox x:Name="EntrySenha" Height="40" BorderBrush="#E2E5EC" BorderThickness="1"
                             Padding="8,0,8,0" VerticalContentAlignment="Center" FontFamily="Segoe UI"
                             Margin="0,0,0,4" KeyDown="EntrySenha_KeyDown"/>

                <TextBlock x:Name="LblStatus" FontFamily="Segoe UI" FontSize="11" Foreground="#D8353F"
                           TextWrapping="Wrap" Margin="0,6,0,6"/>

                <Button x:Name="BtnEntrar" Content="ENTRAR" Height="40" Background="#3457FF" Foreground="White"
                        BorderThickness="0" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                        Cursor="Hand" Margin="0,6,0,0" Click="BtnEntrar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
